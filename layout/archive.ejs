<h1 class="page-heading">Archive</h1>
<ul class="archive-list">
  <% page.posts.each(function(post) { %>
    <li>
      <a href="<%= url_for(post.path) %>">
        <time class="archive-date" datetime="<%= date_xml(post.date) %>">
          <% var m=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];var d=post.date.toDate(); %><%= m[d.getMonth()] + ' ' + d.getDate() + ', ' + d.getFullYear() %>
        </time>
        &nbsp;<span class="archive-title"><%= post.title %></span>
      </a>
    </li>
  <% }); %>
</ul>
<%- partial('_partial/paginator') %>
