<%# 归档页面 - 连续时间线 + 右侧刻度尺 %>

<%
// ============================================
// 数据整理：构建连续时间线
// 所有文章按时间倒序排列
// ============================================
var sorted = [];
page.posts.each(function(post) {
  sorted.push(post);
});
%>

<div class="archive-timeline">
  <%# 搜索框 %>
  <% if (theme.archive && theme.archive.search_enable !== false) { %>
    <div class="archive-search">
      <span class="archive-search-icon">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
      </span>
      <input
        type="text"
        class="archive-search-input"
        placeholder="<%= tr_cfg(theme.archive.search_placeholder, 'archive.search_placeholder') %>"
        aria-label="<%= tr('archive.search_aria') %>"
        autocomplete="off"
        data-debounce="<%= theme.archive.search_debounce || 200 %>"
        data-highlight="<%= theme.archive.highlight_match !== false ? 'true' : 'false' %>"
      >
    </div>
    <% if (theme.archive.show_match_count !== false) { %>
      <div class="archive-search-count"><%= tr('archive.count_all', page.posts.length) %></div>
    <% } %>
  <% } %>

  <%# 时间线主体 %>
  <div class="archive-timeline-body">
    <div class="archive-items">
      <% for (var i = 0; i < sorted.length; i++) { %>
        <% var post = sorted[i]; %>
        <div class="archive-item"
          data-date="<%= post.date.format('YYYY-MM') %>"
          data-title="<%= post.title %>"
          data-tags="<%= post.tags ? post.tags.map(function(t) { return t.name; }).join(',') : '' %>"
          data-categories="<%= post.categories ? post.categories.map(function(c) { return c.name; }).join(',') : '' %>"
          data-content="<%= (post.excerpt || post.content.replace(/<[^>]*>/g, '')).substring(0, 200).replace(/"/g, '&quot;') %>"
        >
          <span class="archive-date"><%= post.date.format('YYYY-MM-DD') %></span>
          <a href="<%= url_for(post.path) %>" class="archive-title"><%= post.title %></a>
        </div>
      <% } %>
    </div>

    <%# 右侧刻度尺容器（由 JS 动态构建） %>
    <div class="timeline-ruler" aria-hidden="true"></div>
  </div>

  <%# 空状态 %>
  <% if (theme.archive && theme.archive.search_enable !== false) { %>
    <div class="archive-empty" style="display: none;">
      <div class="archive-empty-icon">
        <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
          <line x1="8" y1="11" x2="14" y2="11"/>
        </svg>
      </div>
      <p class="archive-empty-text"><%= tr('archive.empty_title') %></p>
      <p class="archive-empty-hint"><%= tr('archive.empty_hint') %></p>
    </div>
  <% } %>

  <%- partial('_partial/paginator') %>
</div>

<%# 搜索 JS + 刻度尺 JS %>
<% if (theme.archive && theme.archive.search_enable !== false) { %>
  <script src="<%= url_for('/js/search.js') %>" defer></script>
<% } %>
<script src="<%= url_for('/js/archive-ruler.js') %>" defer></script>
