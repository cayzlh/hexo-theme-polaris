<% var dp = theme.dossier.path || 'dossier'; %>
<nav class="dossier-tabs">
  <a href="/<%= dp %>/" class="dossier-tab <%= !page.filter ? 'active' : '' %>"><%= tr('dossier.all') %></a>
  <% if (page.allTags) {
    var sorted = Object.keys(page.allTags).sort();
    for (var t = 0; t < sorted.length; t++) {
      var tagName = sorted[t];
      var items = page.allTags[tagName];
      if (items && items.length > 0) { %>
        <a href="/<%= dp %>/tags/<%= encodeURIComponent(tagName) %>/" class="dossier-tab <%= page.filter && page.tagName === tagName ? 'active' : '' %>"><%= tagName %></a>
  <%   }
    }
  } %>
</nav>

<div class="project-list">
  <% if (page.projects) {
    var projKeys = Object.keys(page.projects).filter(function(k) {
      if (!page.filter) return true;
      var p = page.projects[k];
      return p.tags && p.tags.includes(page.tagName);
    }).sort(function(a, b) {
      return (page.projects[b].sort || 0) - (page.projects[a].sort || 0);
    });

    // 卡片字段开关（dossier.card.*）：只影响「显示/不显示」，
    // 不改变文档顺序或 URL，属于纯展示层配置。
    var dcfg = (theme.dossier && theme.dossier.card) || {};
    for (var i = 0; i < projKeys.length; i++) {
      var pid = projKeys[i];
      var proj = page.projects[pid];
      // Count non-index pages (use pre-computed value or fallback)
      var pageCount = (proj.pageCount !== undefined) ? proj.pageCount : (proj.flatList ? proj.flatList.filter(function(f) { return f.name !== 'index' && f.name !== 'README' && f.name !== 'readme'; }).length : 0);
  %>
    <div class="project-card">
      <a href="/<%= dp %>/<%= pid %>/" class="project-card-link">
        <% if (dcfg.show_tags !== false && proj.tags && proj.tags.length > 0) { %>
          <div class="project-tags">
            <% proj.tags.forEach(function(t) { %>
              <span class="project-tag"><%= t %></span>
            <% }); %>
          </div>
        <% } %>
        <div class="project-title"><%= proj.title || proj.name %></div>
        <% if (dcfg.show_description !== false && proj.description) { %>
          <p class="project-desc<%= dcfg.description_lines ? ' project-desc-clamp' : '' %>"<% if (dcfg.description_lines) { %> style="-webkit-line-clamp:<%= dcfg.description_lines %>"<% } %>><%= proj.description %></p>
        <% } %>
        <% if (dcfg.show_count !== false && pageCount > 0) { %>
          <span class="project-count"><%= tr('dossier.doc_count', pageCount) %></span>
        <% } %>
      </a>
    </div>
  <% }
  } %>

</div>
