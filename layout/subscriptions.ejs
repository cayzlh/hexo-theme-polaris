<!-- Subscriptions Page — Polaris theme -->
<div class="subscriptions-page">
  <div class="subscriptions-list">
    <% if (page.isEmpty || !page.items || page.items.length === 0) { %>
      <div class="subscriptions-empty">
        <div class="subscriptions-empty-icon">📡</div>
        <p class="subscriptions-empty-text">暂无订阅内容</p>
        <p class="subscriptions-empty-hint">请在 <code>source/_data/subscriptions.yml</code> 中配置订阅源</p>
      </div>
    <% } else { %>
      <% for (var i = 0; i < page.items.length; i++) {
        var item = page.items[i];
        if (!item) continue;
      %>
        <div class="sub-item">
          <div class="sub-item-header">
            <a class="sub-item-source" href="<%= item.sourceHomepage || '#' %>" target="_blank" rel="noopener">
              <span class="sub-source-icon"><%= item.sourceIcon || '📡' %></span>
              <span class="sub-source-name"><%= item.sourceName %></span>
            </a>
            <span class="sub-item-date"><%= formatDate(item.pubDate) %></span>
          </div>
          <a class="sub-item-link" href="<%= item.link || '#' %>" target="_blank" rel="noopener">
            <%= item.title || '无标题' %>
          </a>
        </div>
      <% } %>
    <% } %>
  </div>

  <!-- ====== 分页 ====== -->
  <% if (!page.isEmpty && page.total > 1) { %>
  <div class="sub-paginator">
    <% if (page.prev) { %>
      <a class="sub-paginator-btn prev" href="<%= url_for(page.prev_link) %>" aria-label="上一页">‹</a>
    <% } else { %>
      <span class="sub-paginator-btn disabled">‹</span>
    <% } %>

    <span class="sub-paginator-info"><%= page.current %> / <%= page.total %></span>

    <% if (page.next) { %>
      <a class="sub-paginator-btn next" href="<%= url_for(page.next_link) %>" aria-label="下一页">›</a>
    <% } else { %>
      <span class="sub-paginator-btn disabled">›</span>
    <% } %>
  </div>
  <% } %>
</div>
