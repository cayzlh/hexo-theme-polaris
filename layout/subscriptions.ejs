<!-- Subscriptions Page — Polaris theme -->
<div class="subscriptions-page">
  <!-- ====== 订阅源列表 ====== -->
  <div class="subscriptions-list">
    <% if (page.isEmpty || !page.feeds || page.feeds.length === 0) { %>
      <div class="subscriptions-empty">
        <div class="subscriptions-empty-icon">📡</div>
        <p class="subscriptions-empty-text">暂无订阅内容</p>
        <p class="subscriptions-empty-hint">请在 <code>source/_data/subscriptions.yml</code> 中配置订阅源</p>
      </div>
    <% } else { %>
      <% for (var i = 0; i < page.feeds.length; i++) {
        var feed = page.feeds[i];
        if (!feed) continue;
      %>
        <div class="subscription-item<%= feed.error ? ' subscription-error' : '' %>">
          <div class="subscription-header">
            <span class="subscription-icon"><%= feed.icon || '📡' %></span>
            <div class="subscription-meta">
              <h2 class="subscription-name">
                <a href="<%= feed.homepage || feed.url || '#' %>" target="_blank" rel="noopener"><%= feed.name || '未知来源' %></a>
              </h2>
              <% if (page.showDescription && feed.description) { %>
                <p class="subscription-desc"><%= feed.description %></p>
              <% } %>
            </div>
            <% if (page.showCount && !feed.error && feed.items) { %>
              <span class="subscription-count"><%= feed.items.length %> 条更新</span>
            <% } %>
          </div>

          <% if (feed.error) { %>
            <p class="subscription-error-msg">⚠️ 获取失败，请检查订阅源</p>
          <% } else if (!feed.items || feed.items.length === 0) { %>
            <p class="subscription-empty-msg">暂无更新</p>
          <% } else { %>
            <ul class="subscription-items">
              <% for (var j = 0; j < feed.items.length; j++) {
                var item = feed.items[j];
                if (!item) continue;
              %>
                <li>
                  <a href="<%= item.link || '#' %>" target="_blank" rel="noopener" class="item-link">
                    <span class="item-date"><%= formatDate(item.pubDate) %></span>
                    <span class="item-title"><%= item.title || '无标题' %></span>
                  </a>
                </li>
              <% } %>
            </ul>
          <% } %>
        </div>
      <% } %>
    <% } %>
  </div>

</div>
