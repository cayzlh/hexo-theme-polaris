<%
  /* ==========================================================================
     订阅页
     --------------------------------------------------------------------------
     结构（从上到下）：
       1. 一句说明（不要大标题——导航已经标明当前是「订阅」了）
       2. 文章流：按日期分组，日期是 mono 小标题
       3. 页脚区「正在关注」：紧凑的源清单，附带每个源的 RSS 地址

     为什么日期提到结构层：原来 10 条平铺，「哪个源、哪天」全靠扫小字。
     现在先沿时间轴走，再决定看哪一条；源退成行内标记，不抢标题。

     为什么「正在关注」放最后且做成紧凑清单：它是订阅入口（每个源给出
     RSS 地址供复制），但读者打开这页首先想看的是「最近有什么更新」，
     不是源目录。所以目录让位给内容。
     ========================================================================== */
  var subCfg = (theme.subscriptions) || {};
  var sources = page.sources || [];
  var showDesc = subCfg.show_description !== false;
  /* 页脚区「正在关注」源清单。默认展示（老站点行为不变）；
     站点明确配 false 时连标题一起不渲染——只留文章流。
     判据用 `!== false` 而不是真值判断，和 show_description 保持一致：
     没配 = 展示，只有写死 false 才关。 */
  var showSources = subCfg.show_sources !== false && sources.length > 0;

  /* 按 YYYY-MM-DD 分组，保持原有倒序。 */
  var groups = [];
  var groupIndex = {};
  (page.items || []).forEach(function (item) {
    var d = item.pubDate ? new Date(item.pubDate) : null;
    var key = (d && !isNaN(d.getTime())) ? date(d, 'YYYY-MM-DD') : tr('subscriptions.unknown_date');
    if (!(key in groupIndex)) {
      groupIndex[key] = groups.length;
      groups.push({ date: key, items: [] });
    }
    groups[groupIndex[key]].items.push(item);
  });
%>

<div class="subs">

  <%# ===== 1. 一句说明（无大标题） ===== %>
  <% if (subCfg.page_note) { %>
  <p class="subs-note"><%= subCfg.page_note %></p>
  <% } %>

  <%# ===== 2. 文章流 ===== %>
  <% if (page.isEmpty || !page.items || page.items.length === 0) { %>
    <div class="subs-empty">
      <p class="subs-empty__text"><%= tr('subscriptions.empty_title') %></p>
      <p class="subs-empty__hint"><%= tr('subscriptions.empty_hint') %></p>
    </div>
  <% } else { %>
    <% groups.forEach(function (group) { %>
    <div class="subs-day">
      <h2 class="subs-day__date"><%= group.date %></h2>
      <ul class="subs-day__list">
        <% group.items.forEach(function (item) { %>
        <li class="subs-entry">
          <a class="subs-entry__title" href="<%= item.link || '#' %>" target="_blank" rel="noopener"><%= item.title || tr('subscriptions.untitled') %></a>
          <a class="subs-entry__source" href="<%= item.sourceHomepage || '#' %>" target="_blank" rel="noopener"><span class="subs-entry__icon" aria-hidden="true"><%= item.sourceIcon || '📡' %></span><%= item.sourceName %></a>
        </li>
        <% }); %>
      </ul>
    </div>
    <% }); %>

    <%# ===== 分页 ===== %>
    <% if (page.total > 1) { %>
    <nav class="subs-pager" aria-label="<%= tr('subscriptions.pager') %>">
      <% if (page.prev) { %>
        <a class="subs-pager__btn" href="<%= url_for(page.prev_link) %>" rel="prev">‹ <%= tr('common.prev_page') %></a>
      <% } else { %>
        <span class="subs-pager__btn is-disabled">‹ <%= tr('common.prev_page') %></span>
      <% } %>
      <span class="subs-pager__info"><%= page.current %> / <%= page.total %></span>
      <% if (page.next) { %>
        <a class="subs-pager__btn" href="<%= url_for(page.next_link) %>" rel="next"><%= tr('common.next_page') %> ›</a>
      <% } else { %>
        <span class="subs-pager__btn is-disabled"><%= tr('common.next_page') %> ›</span>
      <% } %>
    </nav>
    <% } %>
  <% } %>

  <%# ===== 3. 正在关注（页脚区） ===== %>
  <% if (showSources) { %>
  <section class="subs-follow" aria-labelledby="subs-follow-title">
    <h2 class="subs-follow__title" id="subs-follow-title"><%= tr('subscriptions.following', sources.length) %></h2>
    <ul class="subs-follow__list">
      <% sources.forEach(function (src, i) { %>
      <li class="subs-follow__item<%= src.error ? ' is-error' : '' %>">
        <span class="subs-follow__icon" aria-hidden="true"><%= src.icon || '📡' %></span>
        <a class="subs-follow__name" href="<%= src.homepage || src.url %>" target="_blank" rel="noopener"><%= src.name %></a>
        <% if (showDesc && src.description) { %>
          <span class="subs-follow__desc"><%= src.description %></span>
        <% } %>
        <% if (src.error) { %>
          <span class="subs-follow__err"><%= tr('subscriptions.fetch_failed') %></span>
        <% } else { %>
          <code class="subs-follow__url" id="subs-feed-<%= i %>"><%= src.url %></code>
          <button class="subs-follow__copy" type="button" data-copy-target="subs-feed-<%= i %>"
                  aria-label="<%= tr('subscriptions.copy_feed_aria', src.name) %>"><%= tr('subscriptions.copy_feed') %></button>
        <% } %>
      </li>
      <% }); %>
    </ul>
  </section>
  <% } %>

</div>

<% if (showSources) { %>
<script>
/* 「复制订阅地址」：优先 Clipboard API，失败回退到选中文本的旧办法。 */
(function () {
  document.querySelectorAll('.subs-follow__copy').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var target = document.getElementById(btn.getAttribute('data-copy-target'));
      if (!target) return;
      var text = target.textContent.trim();

      function done() {
        var old = btn.textContent;
        btn.textContent = window.tr('common.copied');
        btn.classList.add('is-done');
        setTimeout(function () {
          btn.textContent = old;
          btn.classList.remove('is-done');
        }, 2000);
      }
      function fallback() {
        var range = document.createRange();
        range.selectNodeContents(target);
        var sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(range);
        try { document.execCommand('copy'); done(); } catch (e) {}
        sel.removeAllRanges();
      }

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done).catch(fallback);
      } else {
        fallback();
      }
    });
  });
})();
</script>
<% } %>
