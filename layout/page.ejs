<% if (page.layout === 'post') { %>
  <h1 class="post-title"><%= page.title %></h1>
<% } else if (page.dossier) { %>
  <% var dkey = page.dossier; %>
  <% var proj = theme.dossier && theme.dossier.tree ? theme.dossier.tree[dkey] : null; %>
  <% if (proj) { %>
    <div class="dossier-bread">
      <a href="<%= url_for('/' + (theme.dossier.path || 'dossier') + '/') %>">Dossier</a>
      &nbsp;&raquo;&nbsp;<%= proj.name || dkey %>
    </div>
  <% } %>
  <% if (page.title) { %>
    <h1 class="post-title"><%= page.title %></h1>
  <% } %>
<% } else if (page.layout === 'page') { %>
  <% if (page.title && !page.hide_title) { %>
    <h1 class="post-title"><%= page.title %></h1>
  <% } %>
<% } %>

<% if (page.path && page.path.startsWith('curio/')) { %>
<div class="ab-hero" id="ab-hero">
  <div class="ab-hero-img-wrap">
    <img id="ab-wallpaper" src="" alt="">
  </div>
  <div class="ab-hero-body">
    <h2 id="ab-wp-title"></h2>
    <p id="ab-wp-desc"></p>
    <div class="ab-hero-actions">
      <a class="ab-btn" id="ab-dl" download target="_blank" rel="noopener">⬇ 下载</a>
      <button class="ab-btn" id="ab-copy">🔗 复制链接</button>
    </div>
  </div>
</div>
<% } %>

<div class="post-body">
  <%- page.content %>
</div>

<% if (page.path && page.path.startsWith('curio/')) { %>
<section class="ab-epic" id="ab-epic">
  <h2 class="ab-epic-title">🎮 本周免费游戏</h2>
  <div class="ab-epic-grid" id="epic-grid">加载中…</div>
</section>

<script>
(function(d) {
  /* 数据源地址与 /news/ 共用 daily.api_base（默认官方实例 60s.viki.moe）。 */
  var API = '<%= ((theme.daily && theme.daily.api_base) || "https://60s.viki.moe").replace(/\/+$/, "") %>';

  /* ---- Bing wallpaper ---- */
  fetch(API + '/v2/bing').then(function(r) { return r.json(); }).then(function(res) {
    if (!res || res.code !== 200 || !res.data) return;
    var d2 = res.data;
    var img = d.getElementById('ab-wallpaper');
    var t   = d.getElementById('ab-wp-title');
    var desc = d.getElementById('ab-wp-desc');
    var dl  = d.getElementById('ab-dl');
    if (img)  { img.src = d2.cover_4k || d2.cover; img.alt = d2.title || ''; }
    if (t)    t.textContent = d2.title || '';
    if (desc) desc.textContent = (d2.description || '').slice(0, 120);
    if (dl)   dl.href = d2.cover_4k || d2.cover || '#';
  }).catch(function() {});

  /* ---- copy wallpaper link ---- */
  var copyBtn = d.getElementById('ab-copy');
  if (copyBtn) {
    copyBtn.addEventListener('click', function() {
      var img = d.getElementById('ab-wallpaper');
      if (!img || !img.src) return;
      navigator.clipboard.writeText(img.src).then(function() {
        copyBtn.textContent = '✓ 已复制';
        setTimeout(function() { copyBtn.textContent = '🔗 复制链接'; }, 2000);
      }).catch(function() {});
    });
  }

  /* ---- Epic games ---- */
  fetch(API + '/v2/epic').then(function(r) { return r.json(); }).then(function(res) {
    if (!res || res.code !== 200 || !Array.isArray(res.data)) return;
    var grid = d.getElementById('epic-grid');
    if (!grid) return;
    var html = '';
    for (var i = 0; i < res.data.length; i++) {
      var g = res.data[i];
      var status = g.is_free_now ? '🎉 本周免费' : '🕐 即将免费';
      html += '<a class="ab-epic-card" href="' + g.link + '" target="_blank" rel="noopener">'
        + '<div class="ab-epic-img-wrap"><img class="ab-epic-img" src="' + g.cover + '" alt="" loading="lazy"></div>'
        + '<div class="ab-epic-info">'
        + '<span class="ab-epic-name">' + g.title + '</span>'
        + '<span class="ab-epic-price">' + status + ' · 原价 ' + g.original_price_desc + '</span>'
        + '<span class="ab-epic-date">' + g.free_start + ' ~ ' + g.free_end + '</span>'
        + '</div></a>';
    }
    grid.innerHTML = html;
  }).catch(function() {});
})(document);
</script>
<% } %>

<% if (page.show_links) { %>
  <%- partial('_partial/friend_links') %>
<% } %>

<div class="post-meta">
  <% if (page.layout === 'post' && page.date) { %>
    <time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY-MM-DD') %></time>
    <% if (page.categories && page.categories.length) { %>
      &nbsp;/&nbsp;
      <% page.categories.forEach(function(cat, i) { %>
        <a href="<%= url_for(cat.path) %>"><%= cat.name %></a><%= i < page.categories.length - 1 ? ', ' : '' %>
      <% }); %>
    <% } %>
  <% } %>
  <% if (page.tags && page.tags.length) { %>
    <br><span class="post-tags">
      <% page.tags.forEach(function(tag, i) { %>
        <a href="<%= url_for(tag.path) %>">#<%= tag.name %></a><%= i < page.tags.length - 1 ? ' ' : '' %>
      <% }); %>
    </span>
  <% } %>
</div>

<% if (page.layout === 'post') { %>
  <div class="post-nav">
    <% if (page.prev) { %>
      <a href="<%= url_for(page.prev.path) %>">&larr; <%= page.prev.title %></a>
    <% } %>
    <% if (page.next) { %>
      <a href="<%= url_for(page.next.path) %>"><%= page.next.title %> &rarr;</a>
    <% } %>
  </div>
<% } %>
