<!DOCTYPE html>
<html lang="<%= page.lang || config.language %>">
<%- partial('_partial/head') %>
<body>
  <%- partial('_partial/header') %>
  <main class="main<%= (theme.toc && theme.toc.enable && page.toc && page.toc.length && page.layout !== 'index_dossier' && page.layout !== 'dossier_page') ? ' has-toc' : '' %>">
    <div class="content">
      <%- body %>
      <% if (theme.toc && theme.toc.enable && page.toc && page.toc.length && page.layout !== 'index_dossier' && page.layout !== 'dossier_page') { %>
        <%- partial('_partial/toc') %>
      <% } %>
    </div>
  </main>
  <%- partial('_partial/footer') %>
  <%- partial('_partial/dark_mode') %>
</body>
</html>
