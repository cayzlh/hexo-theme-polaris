<%
// TOC 按钮显示条件：主题启用 TOC、页面有目录内容、且非 dossier（dossier 无独立 TOC 面板）
var hasToc = theme.toc && theme.toc.enable !== false && page.toc && page.toc.length && page.layout !== 'dossier_page' && page.layout !== 'index_dossier';
%>
<% if (theme.mobile && theme.mobile.enable !== false) { %>
<!-- ===== 移动端组合悬浮球（MENU + 主题切换 + 可选 TOC） ===== -->
<div class="fab-overlay" id="fabOverlay"></div>

<div class="fab-group">
  <% if (hasToc) { %>
  <!-- TOC 子球 -->
  <button class="fab-child" id="fabToc" aria-label="打开目录">
    📄
    <span class="fab-label">目录</span>
  </button>
  <% } %>

  <!-- MENU 子球 -->
  <button class="fab-child" id="fabMenu" aria-label="打开菜单">
    ☰
    <span class="fab-label">菜单</span>
  </button>

  <!-- 暗色模式子球 -->
  <button class="fab-child" id="fabDark" aria-label="切换夜间模式">
    <span class="icon-light">☀</span>
    <span class="icon-dark">☾</span>
    <span class="fab-label">主题</span>
  </button>

  <!-- 主球 -->
  <button class="fab-main" id="fabMain" aria-label="展开功能菜单">
    ✦
  </button>
</div>
<% } %>
