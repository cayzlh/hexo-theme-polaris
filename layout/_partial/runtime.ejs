<% if (theme.runtime && theme.runtime.enable) { %>
<div id="site-runtime" class="site-runtime">
  载入中…
</div>

<script>
(function() {
  var startTimeStr = '<%= theme.runtime.start_time || "2022-06-01 00:00:00" %>';
  var tzOffset = 8; // Asia/Shanghai

  // Parse start_time as Asia/Shanghai
  var startParts = startTimeStr.match(/(\d{4})-(\d{2})-(\d{2})\s+(\d{2}):(\d{2}):(\d{2})/);
  if (!startParts) return;
  var startUtc = Date.UTC(
    parseInt(startParts[1], 10),
    parseInt(startParts[2], 10) - 1,
    parseInt(startParts[3], 10),
    parseInt(startParts[4], 10) - tzOffset,
    parseInt(startParts[5], 10),
    parseInt(startParts[6], 10)
  );

  var el = document.getElementById('site-runtime');
  if (!el) return;

  function pad(n) { return n < 10 ? '0' + n : '' + n; }

  function update() {
    var now = new Date();

    // Current time in Asia/Shanghai
    var local = new Date(now.getTime() + (now.getTimezoneOffset() + tzOffset * 60) * 60000);
    var year = local.getUTCFullYear();
    var month = pad(local.getUTCMonth() + 1);
    var day = pad(local.getUTCDate());
    var hours = pad(local.getUTCHours());
    var minutes = pad(local.getUTCMinutes());
    var seconds = pad(local.getUTCSeconds());

    // Uptime
    var diff = now.getTime() - startUtc;
    if (diff < 0) diff = 0;
    var totalSeconds = Math.floor(diff / 1000);
    var days = Math.floor(totalSeconds / 86400);
    var hoursUp = Math.floor((totalSeconds % 86400) / 3600);

    el.innerHTML = '现在是 ' + year + '年' + month + '月' + day + '日 '
      + hours + '时' + minutes + '分' + seconds + '秒'
      + '，本站已经平稳运行了 ' + days + '天' + hoursUp + '小时';
  }

  update();
  setInterval(update, 1000);
})();
</script>
<% } %>
