<%
/**
 * 移动端目录底部面板（独立于桌面侧栏 TOC）
 * ---------------------------------------------------------------------------
 * 单独成块的原因：dossier 文章页的目录由 dossier_page.ejs 的侧栏负责，
 * 在窄屏被整体隐藏，而它自己的 page.toc 是齐的。把面板独立出来后，
 * 这类页面也能从悬浮球的「目录」格拿到目录 —— 而桌面侧栏的渲染条件
 * 保持原样（dossier 不重复渲染一套）。
 *
 * 交互由 source/js/mobile.js 驱动；这里的链接带 data-toc 供其定位标题。
 */
function renderTocPanel(items) {
  var html = '';
  for (var i = 0; i < items.length; i++) {
    var item = items[i];
    html += '<li class="toc-item toc-level-' + item.level + '">';
    html += '<a href="#' + item.id + '" class="toc-link" data-toc="' + item.id + '">' + item.text + '</a>';
    if (item.children && item.children.length > 0) {
      html += '<ul class="toc-list">' + renderTocPanel(item.children) + '</ul>';
    }
    html += '</li>';
  }
  return html;
}
%>
<div class="toc-panel-overlay"></div>
<div class="toc-panel" id="tocPanel" role="dialog" aria-modal="true" aria-label="<%= tr('toc.title') %>">
  <div class="toc-panel-header">
    <span class="toc-panel-title"><%= tr('toc.title') %></span>
    <button class="toc-panel-close" aria-label="<%= tr('toc.close') %>">✕</button>
  </div>
  <div class="toc-panel-body">
    <ul class="toc-list"><%- renderTocPanel(page.toc) %></ul>
  </div>
</div>
