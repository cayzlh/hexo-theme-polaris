<script>
(function(){
  var dm = <%- JSON.stringify(theme.dark_mode || {}) %>;
  var root = document.documentElement;
  var toggle = document.getElementById('dm-toggle');

  function setDark(on) {
    if (on) root.classList.add('dark'); else root.classList.remove('dark');
  }

  if (dm.mode === 'auto') {
    // Time-based, no toggle
    function checkTime() {
      var now = new Date();
      var h = now.getHours(), m = now.getMinutes();
      var current = h * 60 + m;
      var sunsetParts = (dm.sunset || '19:00').split(':').map(Number);
      var sunriseParts = (dm.sunrise || '06:00').split(':').map(Number);
      var sunset = sunsetParts[0] * 60 + (sunsetParts[1] || 0);
      var sunrise = sunriseParts[0] * 60 + (sunriseParts[1] || 0);
      setDark(current >= sunset || current < sunrise);
    }
    checkTime();
    setInterval(checkTime, 60000);
  } else if (dm.mode === 'manual') {
    // Toggle with localStorage
    var stored = localStorage.getItem('vellum-theme');
    var isDark = stored === 'dark';
    setDark(isDark);
    if (toggle) {
      toggle.addEventListener('click', function() {
        root.classList.toggle('dark');
        localStorage.setItem('vellum-theme', root.classList.contains('dark') ? 'dark' : 'light');
      });
    }
  } else if (dm.mode === 'system') {
    // System preference only — no localStorage, no toggle override
    localStorage.removeItem('vellum-theme');
    var mq = window.matchMedia('(prefers-color-scheme: dark)');
    setDark(mq.matches);
    mq.addEventListener('change', function(e) {
      setDark(e.matches);
    });
    // Handle bfcache restore — re-check system preference
    window.addEventListener('pageshow', function() {
      setDark(mq.matches);
    });
  }
})();
</script>
