<footer class="footer">
  <div class="footer-inner">
    <%- partial('_partial/runtime') %>
    <% if (theme.footer && theme.footer.links && theme.footer.links.length) { %>
      <nav class="footer-nav" aria-label="页脚导航">
        <% theme.footer.links.forEach(function(link) { %>
          <a href="<%= link.url %>"<% if (link.external) { %> target="_blank" rel="noopener"<% } %>><%= link.name %></a>
        <% }); %>
      </nav>
    <% } %>
    <div class="footer-info">
      <% if (theme.footer && theme.footer.text) { %>
        <span class="footer-text">
          <%- theme.footer.text %>
        </span>
      <% } %>
      <span class="footer-copy">
        <% if (theme.footer && theme.footer.copyright) { %>
          <%- theme.footer.copyright %>
        <% } else { %>
          © <%= date(new Date(), 'YYYY') %> <a href="<%= url_for('/') %>"><%= config.author || config.title %></a>
        <% } %>
      </span>
    </div>
  </div>
</footer>
