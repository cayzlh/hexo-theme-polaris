<header class="header">
  <div class="header-inner">

    <!-- ======== 第一行：主标题 + 副标题 ======== -->
    <div class="header-top">
      <a href="<%= url_for('/') %>" class="site-title"><%= config.title %></a>
      <% if (config.subtitle) { %>
        <div class="site-subtitle"><%= config.subtitle %></div>
      <% } %>
    </div>

    <!-- ======== 第二行：导航菜单 ======== -->
    <div class="header-bottom">
      <nav class="nav">
        <%
        /* 顶栏高亮的兜底逻辑。
           菜单项命中逻辑写在一处（下面的 itemActive），但"要不要用兜底"
           必须先知道所有项的结果，所以先扫一遍、再渲染——模板里直接写
           forEach 的话，拿不到"有没有命中的总结果"。

           场景：数独这类只出现在页脚的工具页。它不属于任何一级菜单，
           没有兜底时整条顶栏都不亮，读者会以为当前页没有归属。
           配置 menu_active_fallback（写菜单里的 url，通常是 '/'）之后，
           没有任何项命中时就把高亮给它。 */
        var fallbackUrl = theme.menu_active_fallback || '';

        function itemActive(item) {
          var itemPath = item.url ? item.url.replace(/^\//, '').replace(/\/$/, '') : '';
          var hit = (item.url === '/' && is_home()) || (item.url && item.url !== '/' && page.path.startsWith(itemPath + '/'));
          if (item.url === '/archives/' && is_post()) hit = true;
          // 如果有子菜单，子菜单项匹配时父级也高亮
          if (!hit && item.children && item.children.length > 0) {
            item.children.forEach(function(child) {
              if (child.url && !child.divider) {
                var childPath = child.url.replace(/^\//, '').replace(/\/$/, '');
                if (page.path.startsWith(childPath + '/') || page.path === childPath) {
                  hit = true;
                }
              }
            });
          }
          return hit;
        }

        var anyActive = false;
        if (theme.menu) {
          theme.menu.forEach(function(item) { if (itemActive(item)) anyActive = true; });
        }
        %>
        <% if (theme.menu) { theme.menu.forEach(function(item) {
          var isActive = itemActive(item);
          /* 一项都没命中 → 兜底项亮起来（通常就是首页）。 */
          if (!anyActive && fallbackUrl && item.url === fallbackUrl) isActive = true;
        %>
          <% if (item.children && item.children.length > 0) { %>
          <div class="nav-item dropdown">
            <a href="<%= item.url ? url_for(item.url) : '#' %>" class="nav-link dropdown-toggle<%= isActive ? ' active' : '' %>">
              <%= item.name %><span class="arrow">▾</span>
            </a>
            <div class="dropdown-menu">
              <% item.children.forEach(function(child) { %>
                <% if (child.divider) { %>
                <div class="dropdown-divider"></div>
                <% } else { %>
                <a href="<%= url_for(child.url) %>" class="dropdown-item"<%- child.target ? ' target="' + child.target + '"' : '' %>><%= child.name %></a>
                <% } %>
              <% }); %>
            </div>
          </div>
          <% } else { %>
          <%# 一级项也支持 target：站外友链（如「开往」）需要新窗口打开。 %>
          <a href="<%= url_for(item.url) %>" class="nav-link<%= isActive ? ' active' : '' %>"<%- item.target ? ' target="' + item.target + '"' : '' %><%- item.target === '_blank' ? ' rel="noopener"' : '' %>><%= item.name %></a>
          <% } %>
        <% }); } %>
        <% if (theme.dark_mode && (theme.dark_mode.mode === 'manual' || theme.dark_mode.mode === 'system')) { %>
          <%- partial('_partial/dark_toggle') %>
        <% } %>
        <!-- 汉堡菜单按钮（移动端显示）。默认由右下角悬浮球取代；
             mobile.dock.enable=false 时它重新出现，移动端仍有导航入口。 -->
        <button class="nav-toggle" aria-label="打开站点导航">
          <span class="nav-toggle-icon"></span>
        </button>
      </nav>
    </div>

  </div>

  <!-- 移动端导航抽屉（移动端显示） -->
  <div class="nav-drawer" id="navDrawer">
    <% if (theme.menu) { theme.menu.forEach(function(item) {
      /* 与桌面版同一套判断，包括 menu_active_fallback 兜底：
         itemActive / anyActive / fallbackUrl 在上面的 <nav class="nav"> 里
         已经算过，这里直接复用——抽屉和顶栏的高亮必须一致，否则同一个
         页面在宽屏和窄屏上会亮不同的项。 */
      var isActive = itemActive(item);
      if (!anyActive && fallbackUrl && item.url === fallbackUrl) isActive = true;
    %>
      <% if (item.children && item.children.length > 0) { %>
      <div class="drawer-item">
        <div class="drawer-toggle">
          <a href="<%= item.url ? url_for(item.url) : '#' %>" class="nav-link<%= isActive ? ' active' : '' %>"><%= item.name %></a>
          <button class="drawer-sub-toggle" aria-label="Toggle submenu">▸</button>
        </div>
        <div class="drawer-submenu">
          <% item.children.forEach(function(child) { %>
            <% if (child.divider) { %>
            <div class="dropdown-divider"></div>
            <% } else { %>
            <a href="<%= url_for(child.url) %>" class="drawer-sub-link"<%- child.target ? ' target="' + child.target + '"' : '' %>><%= child.name %></a>
            <% } %>
          <% }); %>
        </div>
      </div>
      <% } else { %>
      <a href="<%= url_for(item.url) %>" class="nav-link<%= isActive ? ' active' : '' %>"<%- item.target ? ' target="' + item.target + '"' : '' %><%- item.target === '_blank' ? ' rel="noopener"' : '' %>><%= item.name %></a>
      <% } %>
    <% }); } %>
    <div class="dark-toggle-wrapper">
      <%- partial('_partial/dark_toggle') %>
    </div>
  </div>

  <!-- 导航遮罩层（移动端显示） -->
  <div class="nav-overlay"></div>
</header>

<style>
/* 移动端元素在 PC 端隐藏 */
@media (min-width: 769px) {
  .nav-drawer,
  .nav-overlay,
  .nav-toggle {
    display: none !important;
  }
}
</style>
